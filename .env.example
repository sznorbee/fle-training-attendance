# --- Database (Neon) ---------------------------------------------------------
# Pooled connection string for the app, direct one for migrations.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Neon Auth ---------------------------------------------------------------
# Neon console > Auth. Leave both empty for local development: the app then
# offers a development sign-in (any e-mail) that is disabled in production.
NEON_AUTH_BASE_URL=
# At least 32 characters, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
# Roles are granted by e-mail, so addresses must be verified. Only set this to
# "false" if e-mail verification is switched off in Neon Auth and you accept
# that anyone can sign up with someone else's address.
REQUIRE_VERIFIED_EMAIL=true

# --- Access ------------------------------------------------------------------
# Comma-separated e-mails that are always federation administrators.
ADMIN_EMAILS=

# --- Season ------------------------------------------------------------------
# Year in which the season starts (September). 2026 = season 2026/2027.
SEASON_START_YEAR=2026
APP_TIME_ZONE=Europe/Luxembourg

# --- Daily sync to the shared Google Sheet (optional) -------------------------
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Sent by Vercel Cron as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
